<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Texto de la tarea -->
    <TextView
        android:id="@+id/taskTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:text="Tarea ejemplo" />

    <!-- Chips de estado -->
    <LinearLayout
        android:id="@+id/statusChipsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <!-- Chip Pendiente -->
        <TextView
            android:id="@+id/chipPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/chip_pending"
            android:text="Pendiente"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>

        <!-- Chip En proceso -->
        <TextView
            android:id="@+id/chipInProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/chip_in_progress"
            android:text="En proceso"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>

        <!-- Chip Terminada -->
        <TextView
            android:id="@+id/chipDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@drawable/chip_done"
            android:text="Terminada"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>

    </LinearLayout>

</LinearLayout>

