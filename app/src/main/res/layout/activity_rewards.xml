<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏆 Premios"
            android:textColor="@color/primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/availableRewardsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Premios disponibles"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rewardsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:id="@+id/pendingRequestsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📩 Solicitudes de premios"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/requestsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:id="@+id/approvedRewardsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎁 Premios del personal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/approvedRewardsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:id="@+id/myRewardsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎟️ Mis premios"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myRewardsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>

</ScrollView>